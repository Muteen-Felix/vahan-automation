# Cấu hình runtime của VAHAN RPA (không chứa secret). Sao chép thành .docker.env hoặc để
# `python scripts/setup-docker.py` tự sinh các giá trị <generate>. Không commit .docker.env.
# Mô tả đầy đủ: docs/release/config/config-reference.md

# --- Bắt buộc (setup-docker.py sinh nếu thiếu; Compose dừng nếu thiếu) ---
POSTGRES_PASSWORD=<generate>
DB_APP_USERNAME=vahan_app
DB_APP_PASSWORD=<generate>
VAHAN_UI_AUTH_USERNAME=admin
VAHAN_UI_AUTH_PASSWORD=<generate>
VAHAN_UI_AUTH_TOKEN_SECRET=<generate>
VAHAN_API_RUNNER_TOKEN=<generate>
VAHAN_BROWSER_STATE_KEY=<generate>

# --- Tùy chọn (có mặc định an toàn) ---
API_PORT=8000
WEB_PORT=5173
API_BIND_ADDRESS=127.0.0.1
WEB_BIND_ADDRESS=127.0.0.1
VAHAN_IMAGE_NAMESPACE=vahan-automation
VAHAN_IMAGE_TAG=local
# VAHAN_VCS_REF=<commit sha>   # build-time only: revision label of the 3 app images; unset = unknown (T29)
VAHAN_WORKER_REPLICAS=auto
# VAHAN_API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# VAHAN_API_SOCKETIO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# VAHAN_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
