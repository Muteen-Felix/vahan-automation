{
  "name": "vahan-playwright-runner",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node runner.mjs",
    "check": "node --check runner.mjs && node --check page-driver.js && node --check ui-health-contract.mjs && node --check image-pipe.mjs && node --check page-recovery.mjs",
    "test:ui-health": "node test-ui-health-contract.mjs && node test-health-trigger.mjs",
    "test:results": "node test-results.mjs",
    "test:lifecycle": "node test-job-lifecycle.mjs",
    "test:filters": "node test-filter-fill.mjs",
    "test:options": "node test-options.mjs",
    "test:navigation": "node test-navigation.mjs && node test-page-recovery.mjs",
    "test:image-pipe": "node test-image-pipe.mjs",
    "test:profile-options": "node test-profile-options.mjs",
    "test:main-report-save": "node test-main-report-save.mjs"
  },
  "dependencies": {
    "playwright": "1.63.0",
    "socket.io-client": "4.8.1"
  }
}
