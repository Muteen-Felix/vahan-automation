{
  "manifest_version": 3,
  "name": "Vinfast RPA Assistant",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "storage",
    "downloads",
    "alarms",
    "scripting",
    "webRequest",
    "webRequestAuthProvider"
  ],
  "host_permissions": [
    "https://analytics.parivahan.gov.in/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Vinfast RPA Assistant",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://analytics.parivahan.gov.in/analytics/vahanpublicreport*"],
      "js": ["interceptor-main.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://analytics.parivahan.gov.in/analytics/vahanpublicreport*"],
      "js": ["ui-drift/guard.js", "content.js", "ui-drift/health-check-content.js"],
      "run_at": "document_idle"
    }
  ]
}
